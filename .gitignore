# ============================================================
#  绝对不能提交的东西
# ============================================================

# 登录态（含 cookie / session / localStorage）—— 泄露等于账号被接管
config/cookies/*
!config/cookies/.gitkeep

# 浏览器持久化 profile（含所有网站登录态，最危险）
config/browser_profile/
config/*.storage.json

# GitHub / 其他平台 token
config/github_token.txt
config/*token*
config/*secret*

# 采集到的数据、下载的图片视频
# 注意：不能用 data/* —— 那会把 data/mapping/ 整个目录也忽略掉，
# 而 !data/mapping/ 无法恢复「父目录已被忽略」的子项。所以显式列出要忽略的。
data/raw/
data/items/
data/media/
data/app.db
data/app.db-journal
data/*.csv
data/*.log

# 映射层配置模板**要提交**（M2 的核心资产，新环境开箱可用）
!data/mapping/
!data/mapping/*.yaml
!data/mapping/*.yml
!data/mapping/*.json

# pair 工具工作区（Codex 规划/复审记录，含会话状态，不入库）
.pair/

# 逆向分析产物（第三方扩展的源码，仅供本地研究，不要公开分发）
analysis/

# 本地配置（可能含 key）
config/settings.yaml

# ============================================================
#  常规忽略
# ============================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.env.*

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 日志与临时文件
*.log
*.tmp
links.txt
*.csv
!docs/**/*.csv

# 测试产物
.pytest_cache/
.coverage
htmlcov/
